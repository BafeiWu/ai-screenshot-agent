{
  "name": "doubao-screenshot",
  "version": "1.0.0",
  "description": "Global screenshot + auto‑upload AI desktop tool with floating result panel",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/BafeiWu/ai-screenshot-agent.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder"
  },
  "keywords": [
    "electron",
    "screenshot",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^23.6.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "build": {
    "appId": "com.ai.screenshot",
    "productName": "AI截图",
    "icon": "./icon.ico",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "BafeiWu",
      "repo": "ai-screenshot-agent"
    }
  }
}
