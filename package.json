{
  "name": "ai-screenshot-agent",
  "version": "1.2.1",
  "description": "Global screenshot + auto‑upload AI desktop tool with floating result panel",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/BafeiWu/ai-screenshot-agent.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:mac:arm": "vite build && electron-builder --mac --arm64",
    "electron:build:mac:x64": "vite build && electron-builder --mac --x64"
  },
  "keywords": [
    "electron",
    "screenshot",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^23.6.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.4",
    "pinia": "^2.1.7",
    "tesseract.js": "^5.1.1",
    "vue": "^3.4.0"
  },
  "build": {
    "appId": "com.ai.screenshot",
    "productName": "SnapAI",
    "artifactName": "ai-screenshot-agent-setup-${version}.${ext}",
    "icon": "./icon.ico",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "./icon.png",
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "ai-screenshot-agent-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "SnapAI ${version}",
      "writeUpdateInfo": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "BafeiWu",
      "repo": "ai-screenshot-agent"
    }
  }
}
